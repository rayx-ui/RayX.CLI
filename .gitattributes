# Store text with LF and check it out with LF on every OS, including WSL clones.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets the CLI or its fixtures may carry.
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.jar binary
*.zip binary
*.gz binary
